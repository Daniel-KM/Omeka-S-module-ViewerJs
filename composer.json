{
    "name": "daniel-km/omeka-s-module-viewer-js",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Display standard document formats (pdf and office: pdf, odt, ods, odp) in a light unified player.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "viewer",
        "display",
        "document viewer",
        "open document",
        "pdf",
        "odt",
        "ods",
        "odp"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-ViewerJs",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-ViewerJs/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^4.1",
        "daniel-km/omeka-s-module-common": "*"
    },
    "require": {
        "sempia/external-assets": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "ViewerJs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ViewerJsTest\\": "tests/ViewerJsTest/"
        }
    },
    "config": {
        "allow-plugins": {
            "sempia/external-assets": true
        }
    },
    "extra": {
        "installer-name": "ViewerJs",
        "external-assets": {
            "asset/vendor/viewerjs/": "https://gitlab.com/Daniel-KM/ViewerJS/-/releases/0.7.2/downloads/viewerjs-0.7.2.zip"
        }
    }
}
